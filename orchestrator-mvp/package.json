{
  "name": "orchestrator-mvp",
  "version": "0.1.0",
  "description": "Multi-model sandboxed agent orchestrator: routes one query to isolated model workers via the Cursor SDK, merges outputs within a confidence bound.",
  "type": "module",
  "private": true,
  "scripts": {
    "server": "node node_modules/tsx/dist/cli.mjs src/index.ts --server",
    "query": "node node_modules/tsx/dist/cli.mjs src/index.ts --query",
    "phone-agent": "node node_modules/tsx/dist/cli.mjs src/agents/phoneAgent.ts",
    "models": "node node_modules/tsx/dist/cli.mjs scripts/list-models.ts",
    "eval": "node node_modules/tsx/dist/cli.mjs scripts/eval.ts",
    "analyze": "node node_modules/tsx/dist/cli.mjs scripts/eval.ts --sqlite",
    "economics": "node node_modules/tsx/dist/cli.mjs scripts/supply-economics.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build": "npm run web:build"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
